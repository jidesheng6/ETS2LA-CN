<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ETS2LA.UI.Views.Settings"
             xmlns:husk="https://github.com/d3ara1n/Huskui.Avalonia"
             x:Class="ETS2LA.UI.Views.Settings.DataSettingsPage"
             x:DataType="views:DataSettingsPage">
    <StackPanel>
        <Grid ColumnDefinitions="500,*">
        <StackPanel Grid.Column="0" Spacing="20" Margin="20">

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="强制基础地图名称" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ForceBaseMapName}" Classes="primary-toggle" AutomationProperties.Name="强制基础地图名称，目前仅 RusMap 需要，需要重启" />
                </Grid>
                <TextBlock Text="一些模组会提供 japan.mbd 或 russia.mbd 等额外地图。如果模组加载异常，可以尝试启用此选项。RusMap 必须启用此选项。" FontSize="12" Classes="Description" />
                <StackPanel IsVisible="{Binding BaseMapNameNeedsRestart}">
                    <TextBlock Text="警告：需要重启 ETS2LA 才能应用此更改。" FontSize="12" Classes="Warning" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="强制加载地图" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ForceMapLoad}" Classes="primary-toggle" AutomationProperties.Name="游戏启动时强制加载地图，需要重启" />
                </Grid>
                <TextBlock Text="强制 ETS2LA 在游戏启动时加载地图，可以解决 game.log.txt 不在预期位置的问题。" FontSize="12" Classes="Description" />
                <StackPanel IsVisible="{Binding ForceMapLoadNeedsRestart}">
                    <TextBlock Text="警告：需要重启 ETS2LA 才能应用此更改。" FontSize="12" Classes="Warning" />
                </StackPanel>
            </StackPanel>

            <Separator />

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="数据精度" />
                    <TextBlock Text="调整所使用游戏数据的详细程度。数值越高占用的内存越多，但包含的信息也越丰富。所有等级的驾驶效果相同。" FontSize="12" Classes="Description" />
                </StackPanel>
                <TabStrip ItemsSource="{Binding DataFidelityOptions}" 
                        SelectedIndex="{Binding SelectedDataFidelityOption}" 
                        SelectionChanged="OnDataFidelityChanged"
                        AutomationProperties.Name="数据精度，数值越高占用内存越多">

                    <TabStrip.Styles>
                        <Style Selector="TabStripItem" x:DataType="views:TabStripItemHandler">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </TabStrip.Styles>

                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="views:TabStripItemHandler">
                            <Border Width="70" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
                <StackPanel Spacing="3" IsVisible="{Binding ShowRamWarning}">
                    <TextBlock Text="由于内存不足，部分数据精度选项不可用。高需要 16GB，极高需要 20GB。" FontSize="12" Classes="Warning" />
                </StackPanel>

                <StackPanel Spacing="3" IsVisible="{Binding ShowLowInfo}">
                    <TextBlock Text="此设置只加载游戏地图中可见的道路和路口，其他信息会被丢弃。" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="3" IsVisible="{Binding ShowMediumInfo}">
                    <TextBlock Text="此设置会删除冗余信息，同时保留大多数细节对象（例如标志）。不包含游戏地图中未显示的道路或路口。" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="3" IsVisible="{Binding ShowHighInfo}">
                    <TextBlock Text="此设置会删除冗余信息，同时保留大多数细节对象（例如标志）。包含所有隐藏道路和 AI 专用道路。" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="3" IsVisible="{Binding ShowExtremeInfo}">
                    <TextBlock Text="此设置包含所有可用数据，其中大部分是冗余信息。" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="3" IsVisible="{Binding ShowExtremeWarning}">
                    <TextBlock Text="警告：极高精度会占用大量内存，预计超过 10GB。" FontSize="12" Classes="Warning" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Text="曲线质量" />
                    <TextBlock Text="调整路径规划和可视化所使用曲线的质量，默认设置与游戏一致。" FontSize="12" Classes="Description" />
                </StackPanel>
                <TabStrip ItemsSource="{Binding CurveQualityOptions}" 
                        SelectedIndex="{Binding SelectedCurveQualityOption}" 
                        SelectionChanged="OnCurveQualityChanged"
                        AutomationProperties.Name="曲线质量">

                    <TabStrip.Styles>
                        <Style Selector="TabStripItem" x:DataType="views:TabStripItemHandler">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </TabStrip.Styles>
                    
                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="views:TabStripItemHandler">
                            <Border Width="115" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Header}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
            </StackPanel>
        </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>